# AMO (addons.mozilla.org) API credentials used to sign rhesus-share.
# Generate at: https://addons.mozilla.org/developers/addon/api/key/
# Copy this file to .env and fill in the values.

AMO_JWT_ISSUER=
AMO_JWT_SECRET=

# Optional: override if your rhesus-server container name or the nginx path
# it serves the .xpi from differ from the defaults in sign.sh.
# DOCKER_CONTAINER=ttrss-rhesus-server-1
# NGINX_XPI_PATH=/usr/share/nginx/html/rhesus-share.xpi
